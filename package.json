{
  "name": "application-tracker",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently --raw \"npm --prefix apps/api run dev\" \"npm --prefix apps/web run dev\"",
    "dev:api": "npm run dev --prefix apps/api",
    "dev:web": "npm run dev --prefix apps/web",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:studio": "npm run db:studio --prefix apps/api",
    "db:migrate": "npm run db:migrate:dev --prefix apps/api",
    "db:generate": "npm run db:generate --prefix apps/api",
    "prod:up": "docker compose -f docker-compose.prod.yml up -d --build",
    "prod:down": "docker compose -f docker-compose.prod.yml down",
    "prod:logs": "docker compose -f docker-compose.prod.yml logs -f"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dudeldups/application-tracker.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Dudeldups/application-tracker/issues"
  },
  "homepage": "https://github.com/Dudeldups/application-tracker#readme",
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
